<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/cameraFragment">

    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.ekenahmetfaruk.vigna_scan.ui.camera.CameraFragment"
        android:label="CameraFragment">

        <action
            android:id="@+id/action_camera_to_result"
            app:destination="@id/resultFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.ekenahmetfaruk.vigna_scan.ui.result.ResultFragment"
        android:label="ResultFragment">

        <argument
            android:name="model1Result"
            app:argType="com.ekenahmetfaruk.vigna_scan.ml.ModelResult" />

        <argument
            android:name="model2Result"
            app:argType="com.ekenahmetfaruk.vigna_scan.ml.ModelResult" />

        <argument
            android:name="imagePath"
            app:argType="string" />

    </fragment>

</navigation>